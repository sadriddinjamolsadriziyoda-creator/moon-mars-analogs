# Copy to .env and fill in. Never commit .env.
# The server runs fine with neither of these set — it falls back to the JSON catalog on disk
# and disables the admin routes. That is the intended offline demo mode, not an error.

# MongoDB Atlas free tier (M0) or a local mongod. Leave empty to run without a database.
MONGODB_URI=

# Any long random string. Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# If unset, every /api/admin route answers 503 instead of silently accepting writes.
ADMIN_TOKEN=

PORT=8787
CORS_ORIGIN=http://localhost:5173